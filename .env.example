# Copy to .env and fill in. Load it with `uv run --env-file .env <command>`
# (see README.md / CLAUDE.md) -- nothing in this codebase auto-loads .env,
# by design, to avoid a module-import-order footgun (see docs/architecture.md).
# Never commit .env itself -- it's gitignored; this file should only ever
# contain blank placeholders.

# Required
DATABASE_URL=
QDRANT_URL=
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# Optional -- each already has a sane default in code; only set these to
# override it for your own deployment.
# RERANK_CONFIDENCE_THRESHOLD=0.5   # decision #45
# EMBED_BATCH_SIZE=64               # decision #46
# MAX_CONCURRENT_JOBS=1             # decision #38
# WORKER_POLL_INTERVAL_SECONDS=2
